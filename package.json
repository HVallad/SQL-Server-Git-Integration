{
    "name": "mssql-git-sync",
    "displayName": "MSSQL Git Sync",
    "description": "Git repository synchronization for SQL Server databases - script and version control your database objects",
    "version": "0.1.0",
    "publisher": "your-publisher-name",
    "engines": {
        "vscode": "^1.98.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "SQL",
        "MSSQL",
        "Git",
        "Database",
        "Version Control",
        "SQL Server"
    ],
    "activationEvents": [
        "onCommand:mssql-git-sync.scriptDatabaseToGit",
        "onCommand:mssql-git-sync.linkToGit",
        "onCommand:mssql-git-sync.unlinkFromGit"
    ],
    "main": "./out/extension.js",
    "extensionDependencies": [
        "ms-mssql.mssql"
    ],
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "mssql-git-sync",
                    "title": "MSSQL Git Sync",
                    "icon": "$(database)"
                }
            ]
        },
        "views": {
            "mssql-git-sync": [
                {
                    "type": "webview",
                    "id": "mssql-git-sync.gitSyncPanel",
                    "name": "Git Sync Manager"
                }
            ]
        },
        "commands": [
            {
                "command": "mssql-git-sync.scriptDatabaseToGit",
                "title": "Sync Local Cache",
                "category": "MSSQL Git Sync"
            },
            {
                "command": "mssql-git-sync.linkToGit",
                "title": "Link to Git",
                "category": "MSSQL Git Sync"
            },
            {
                "command": "mssql-git-sync.unlinkFromGit",
                "title": "Unlink from Git",
                "category": "MSSQL Git Sync"
            }
        ],
        "menus": {
            "view/item/context": [
                {
                    "command": "mssql-git-sync.scriptDatabaseToGit",
                    "when": "view == objectExplorer && viewItem =~ /\\btype=(Database)\\b/",
                    "group": "9_MSSQL_GIT_SYNC@1"
                },
                {
                    "command": "mssql-git-sync.linkToGit",
                    "when": "view == objectExplorer && viewItem =~ /\\btype=(Database)\\b/",
                    "group": "9_MSSQL_GIT_SYNC@2"
                },
                {
                    "command": "mssql-git-sync.unlinkFromGit",
                    "when": "view == objectExplorer && viewItem =~ /\\btype=(Database)\\b/",
                    "group": "9_MSSQL_GIT_SYNC@3"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "lint": "eslint src --ext ts"
    },
    "devDependencies": {
        "@types/node": "^20.x",
        "@types/vscode": "^1.98.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "typescript": "^5.3.0"
    },
    "dependencies": {}
}

